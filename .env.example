# ---------------------------------------------------------------------------
# PROBE configuration — copy to .env and fill in what you need.
# Every variable is prefixed with PROBE_ and read by the FastAPI backend.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# none | openai | anthropic | gemini | openai-compatible
# Configure a provider to run every exploration agent and Review AI through your model.
# "none" is explicit heuristic/offline mode, not an LLM inspection.
PROBE_LLM_PROVIDER=none
# Leave false for real model-driven inspection. Set true only for explicit offline/demo runs.
PROBE_ALLOW_HEURISTIC_MODE=false
PROBE_LLM_MODEL=
PROBE_LLM_API_KEY=
# only needed for "openai-compatible" (local servers, OpenRouter, etc.)
PROBE_LLM_BASE_URL=

# --- Browser ---------------------------------------------------------------
# playwright (real Chromium; default — run `uv run --project services/api playwright install chromium`)
# auto (same strict Chromium behavior, no simulator fallback)
# mock (explicit DemoShop simulator for tests only; never visits the supplied URL)
PROBE_BROWSER_MODE=playwright
PROBE_HEADLESS=true
PROBE_RECORD_VIDEO=false

# --- Agents ----------------------------------------------------------------
PROBE_MAX_STEPS_PER_AGENT=20
PROBE_AGENT_STEP_DELAY=0.15
PROBE_SLOW_ACTION_MS=2500
PROBE_REPRODUCE_ATTEMPTS=3
PROBE_MOCK_LATENCY=1.2

# --- Server / storage ------------------------------------------------------
PROBE_HOST=0.0.0.0
PROBE_PORT=8000
PROBE_DATA_DIR=data
PROBE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
